# Code-agent 部署环境变量样例
# 复制为 .env 后填写，切勿把真实密钥提交进仓库。
#
# 本文件会被 python -m code_agent.server / python -m code_agent.cli 自动加载
# （也可用 CODE_AGENT_ENV_FILE 指定其他路径）。优先级：真实环境变量 > .env > 默认值。
# Docker 部署时 compose 同样读它做 ${VAR} 替换，本地与容器共用一份配置。

# ---- 模型 ----
# deepseek | openai | openai_compat | offline（offline 无需 key，用于无外网环境演示/回归）
CODE_AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 之外的后端（内网网关 / vLLM / Ollama / One-API）统一走 openai_compat：
#   CODE_AGENT_PROVIDER=openai_compat
#   OPENAI_BASE_URL=http://10.0.0.9:8000/v1
#   OPENAI_API_KEY=any-non-empty-string
#   OPENAI_MODEL=Qwen2.5-14B-Instruct
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 档位模型名（留空则用 provider 默认：DeepSeek=deepseek-chat，openai 家族=gpt-4o-mini）
CODE_AGENT_MODEL_LITE=
CODE_AGENT_MODEL_DEFAULT=
CODE_AGENT_MODEL_CRAFT=

# 瞬时故障（429/5xx/超时）重试次数：指数退避 + 抖动；流式仅在未输出增量时重试
CODE_AGENT_LLM_RETRIES=3

# ---- 智能体执行 ----
# classic 默认持续执行，不按固定段长分段；正整数显式启用段长检查点。
CODE_AGENT_MAX_TURNS=0
# 单次用户请求的总模型步骤上限（跨段精确累计）；0 = 不设此上限。
CODE_AGENT_MAX_TOTAL_TURNS=1200
# 仅显式启用正段长时使用的自动续跑次数；0 = 禁止段界续跑。
CODE_AGENT_MAX_CONTINUATIONS=40
# 同调用连续失败的硬停阈值：默认关闭，正整数才启用。
CODE_AGENT_FAILURE_STREAK=0
# 同调用连续重复到各阈值时提醒一次，不中断执行；0 = 关闭提醒。
CODE_AGENT_REPEAT_THRESHOLDS=3,5,8
# 同轮工具并行；0 = 串行，每次调用仍执行权限、审批与日志链路。
CODE_AGENT_TOOL_PARALLEL=1
# 全局工具超时兜底（秒）：0 = 无兜底，工具自身超时声明优先。
CODE_AGENT_TOOL_TIMEOUT_DEFAULT=0
# 后台结果连续自动唤醒上限；0 = 禁止自动唤醒，通知留待下次调用读取。
CODE_AGENT_MAX_CONSECUTIVE_WAKES=3
# 已弃用：旧收口自查追问已移除，此环境变量不再生效，不能重新开启追问。
# CODE_AGENT_CLOSURE_LIMIT=0
# 模型 length/max_tokens/content_filter 等异常停止不会执行随附工具或自动重放。
# 执行循环不提升权限或绕过审批。

# ---- 访问模式 ----
# 默认本地单用户直接打开工作台，HTTP 与 WebSocket 均无需登录或 token。
# 对外部署/旧客户端需要 JWT 时设 true，并配置下方密钥和管理员密码。
CODE_AGENT_AUTH_ENABLED=false
# JWT 签名密钥（认证模式）：建议 `python -c "import secrets;print(secrets.token_urlsafe(48))"`
# 留空时会在数据目录持久化生成随机密钥。
CODE_AGENT_SECRET=
CODE_AGENT_ADMIN_USER=admin
CODE_AGENT_ADMIN_PASSWORD=

# ---- 沙箱与超时 ----
# process：容器内进程组隔离（默认）；docker：套娃容器隔离（需挂 /var/run/docker.sock）
CODE_AGENT_SANDBOX_MODE=process
CODE_AGENT_SANDBOX_IMAGE=python:3.13-slim
# WebSocket 空闲断开阈值（秒）
CODE_AGENT_WS_IDLE_TIMEOUT=120
# 人工审批等待上限（秒），超时 fail closed
CODE_AGENT_APPROVAL_TIMEOUT=120
# 工作历史软上限（字符）；大模型窗口不会自动放大此值，用户约束不静默丢弃
CODE_AGENT_HISTORY_BUDGET=24000
# 大输出外部化阈值（字节）
CODE_AGENT_EXTERNALIZE_THRESHOLD=65536

# ---- 插件包（M10）----
# 插件目录：<CODE_AGENT_HOME>/plugins/<name>/plugin.json
# 技能 / MCP / 放行名单 / prompt 片段都是声明式的，走既有信任门禁，不会被插件绕过。
# 代码式工具（插件里的 tools.py）等于让第三方代码在本进程内执行，会旁路沙箱与权限链路，
# 因此默认关闭；必须 **这里设为 1 且插件清单里 codeTools=true** 才会加载（缺一即跳过）。
CODE_AGENT_PLUGIN_CODE=0

# ---- 端口 ----
CODE_AGENT_HTTP_PORT=8080
