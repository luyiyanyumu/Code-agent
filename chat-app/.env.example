# Template only. The server does not automatically read this file or parent .env files.
# Set these variables in your shell, container, or process manager.
CHAT_AGENT_HOME=
CHAT_AGENT_HOST=127.0.0.1
CHAT_AGENT_PORT=8766
CHAT_AGENT_PROVIDER=offline
CHAT_AGENT_API_BASE=
CHAT_AGENT_API_KEY=
CHAT_AGENT_MODEL=
# Required before exposing the server beyond localhost. Never commit a real token.
CHAT_AGENT_ACCESS_TOKEN=
CHAT_AGENT_ALLOWED_ORIGINS=
CHAT_AGENT_DEFAULT_PERMISSION=workspace-write
CHAT_AGENT_MAX_UPLOAD_BYTES=10485760
CHAT_AGENT_MAX_ROUNDS=8
CHAT_AGENT_REQUEST_TIMEOUT=90
# Vite dev/preview proxy (not needed when serving dist from the backend)
CHAT_AGENT_API_TARGET=http://127.0.0.1:8766
